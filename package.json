{
  "name": "vcash",
  "version": "0.1.0",
  "private": true,
  "description": "vcash POS 系统 - Vendure 多租户多仓库收银",
  "scripts": {
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @vcash/web build",
    "build:server": "pnpm --filter server build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter server dev",
    "populate": "pnpm --filter server populate",
    "start:prod": "cross-env NODE_ENV=production node server/dist/index.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@graphql-tools/delegate": "12.1.0",
      "@graphql-tools/wrap": "11.1.20"
    }
  }
}
